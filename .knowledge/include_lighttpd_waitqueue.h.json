{"is_source_file": true, "format": "C header file", "description": "This header file defines the data structures, function declarations, and descriptions for a lightweight wait queue used to manage delays and timeouts for tasks like I/O operations and throttling in the Lighttpd server. It provides an API for initializing, stopping, updating, pushing, popping, and removing wait queue elements.", "external_files": ["<lighttpd/settings.h>", "<lighttpd/events.h>"], "external_methods": [], "published": ["li_waitqueue_init", "li_waitqueue_stop", "li_waitqueue_set_delay", "li_waitqueue_update", "li_waitqueue_push", "li_waitqueue_pop", "li_waitqueue_pop_force", "li_waitqueue_pop_ready", "li_waitqueue_remove"], "classes": [], "methods": [{"name": "li_waitqueue_init", "description": "Initializes a waitqueue, creating a timer and setting it up with the specified delay and callback."}, {"name": "li_waitqueue_stop", "description": "Stops the waitqueue, halting its timer."}, {"name": "li_waitqueue_set_delay", "description": "Updates the delay of the waitqueue's timer, stopping and restarting it if active."}, {"name": "li_waitqueue_update", "description": "Updates the timeout of the waitqueue, to be called after callback execution."}, {"name": "li_waitqueue_push", "description": "Adds or moves an element to the end of the waitqueue."}, {"name": "li_waitqueue_pop", "description": "Pops the first ready element from the waitqueue."}, {"name": "li_waitqueue_pop_force", "description": "Removes and returns the first element from the queue, regardless of its readiness."}, {"name": "li_waitqueue_pop_ready", "description": "Removes and returns all elements that are ready, returning their count."}, {"name": "li_waitqueue_remove", "description": "Removes a specific element from the waitqueue."}], "calls": ["li_waitqueue_init", "li_waitqueue_stop", "li_waitqueue_set_delay", "li_waitqueue_update", "li_waitqueue_push", "li_waitqueue_pop", "li_waitqueue_pop_force", "li_waitqueue_pop_ready", "li_