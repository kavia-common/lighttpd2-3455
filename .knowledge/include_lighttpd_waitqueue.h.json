{"is_source_file": true, "format": "C header file", "description": "This file defines the structures, function prototypes, and documentation for a waitqueue module used in the lighttpd server project. It provides an interface for managing lightweight, non-blocking wait queues for tasks like IO timeouts and throttling.", "external_files": ["<lighttpd/settings.h>", "<lighttpd/events.h>"], "external_methods": ["lighttpd_settings.h", "lighttpd/events.h"], "published": ["li_waitqueue_init", "li_waitqueue_stop", "li_waitqueue_set_delay", "li_waitqueue_update", "li_waitqueue_push", "li_waitqueue_pop", "li_waitqueue_pop_force", "li_waitqueue_pop_ready", "li_waitqueue_remove"], "classes": [], "methods": [{"name": "li_waitqueue_init", "description": "Initializes a waitqueue with a specified delay and callback, associated with an event loop."}, {"name": "li_waitqueue_stop", "description": "Stops the waitqueue, halting its timer."}, {"name": "li_waitqueue_set_delay", "description": "Updates the delay of the waitqueue's timer."}, {"name": "li_waitqueue_update", "description": "Resets the waitqueue's timer based on the current delay."}, {"name": "li_waitqueue_push", "description": "Adds an element to the waitqueue, moving it to the end if already queued."}, {"name": "li_waitqueue_pop", "description": "Pops the first ready element from the waitqueue."}, {"name": "li_waitqueue_pop_force", "description": "Removes and returns the first element from the waitqueue, regardless of its readiness."}, {"name": "li_waitqueue_pop_ready", "description": "Removes and returns all elements that are ready, returning the count."}, {"name": "li_waitqueue_remove", "description": "Removes a specific element from the waitqueue."}], "calls": ["li_waitqueue_init", "li_waitqueue_stop", "li_waitqueue_set_delay", "li_waitqueue_update", "li_waitqueue_push", "li_waitqueue_pop", "li_waitqueue_pop_force", "li_waitqueue_pop_ready", "li_waitqueue_remove"], "search-terms": ["waitqueue", "lighttpd waitqueue", "li_w