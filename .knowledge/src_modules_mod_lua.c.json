a plugin data, such as actions, setups, filename, and associated GString structures."}], "methods": [{"name": "gboolean lua_find_file(GString * filename)", "description": "Resolves the filename for a Lua script by searching in default directory or filesystem.", "scope": "", "scopeKind": ""}, {"name": "liHandlerResult lua_handle(liVRequest * vr,gpointer param,gpointer * context)", "description": "Handles execution of Lua scripts upon request, managing cache validity and load state.", "scope": "", "scopeKind": ""}, {"name": "void lua_config_free(liServer * srv,gpointer param)", "description": "Frees memory associated with a lua_config structure, including worker configs and file name.", "scope": "", "scopeKind": ""}, {"name": "lua_config * lua_config_new(liServer * srv,liPlugin * p,GString * filename,guint ttl,liValue * args)", "description": "Creates a new lua_config instance, resolving the filename and initializing attributes.", "scope": "", "scopeKind": ""}, {"name": "liAction * lua_handler_create(liServer * srv,liWorker * wrk,liPlugin * p,liValue * val,gpointer userdata)", "description": "Creates a handler for Lua scripts based on provided arguments, including filename, options, and arguments.", "scope": "", "scopeKind": ""}, {"name": "gboolean lua_plugin_handle_setup(liServer * srv,liPlugin * p,liValue * val,gpointer userdata)", "description": "Handles setup phase of a Lua plugin, executing Lua setup functions.", "scope": "", "scopeKind": ""}, {"name": "liAction * lua_plugin_handle_action(liServer * srv,liWorker * wrk,liPlugin * p,liValue * val,gpointer userdata)", "description": "Handles action invocation for a Lua plugin, executing the Lua function to produce an action.", "scope": "", "scopeKind": ""}, {"name": "void lua_plugin_free_data(liServer * srv,luaPlugin * lp)", "description": "Frees resources associated with a luaPlugin instance, including Lua references and memory allocations.", "scope": "", "scopeKind": ""}, {"name": "luaPlugin * lua_plugin_create_da