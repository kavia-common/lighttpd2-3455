{"is_source_file": true, "format": "C header", "description": "This file defines the data structures and API functions for representing and manipulating 'values' in the lighttpd server codebase. It includes definitions for different value types such as boolean, number, string, list, action, and condition, along with functions for creating, copying, clearing, and converting these values.", "external_files": ["<lighttpd/settings.h>", "<lighttpd/base.h>", "<lighttpd/angel_base.h>"], "external_methods": ["gboolean", "gint64", "GString *", "GPtrArray *", "GHashTable *", "liServer *", "liAction *", "liCondition *"], "published": ["li_value_new_none", "li_value_new_bool", "li_value_new_number", "li_value_new_string", "li_value_new_list", "li_value_new_action", "li_value_new_condition", "li_value_new_hashtable", "li_value_list_append", "li_value_wrap_in_list", "li_value_copy", "li_value_clear", "li_value_free", "li_value_move", "li_valuetype_string", "li_value_type_string", "li_value_to_string", "li_value_list_free", "li_value_extract_ptr", "li_value_extract_string", "li_value_extract_list", "li_value_extract_action", "li_value_extract_condition", "li_value_extract", "li_value_to_key_value_list", "li_value_get_single_argument", "li_value_is_nothing", "li_value_type", "li_value_list_has_len", "li_value_list_len", "li_value_list_at", "li_value_list_type_at", "li_value_list_set"], "classes": [{"name": "liValue", "description": "A struct representing a generic container for various data types used within the lighttpd server, supporting types such as boolean, number, string, list, action, and condition."}], "methods": [{"name": "li_value_new_none", "description": "Creates a new liValue of type NONE."}, {"name": "li_value_new_bool", "description": "Creates a new liValue representing a boolean value."}, {"name": "li_value_new_number", "description": "Creates a new liValue representing a 64-bit integer number."}, {"name": "li_value_new_string", "description": "Creates a new liValue